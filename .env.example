# Supabase (SERVER ONLY)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx
# Project lama dapat memakai service-role key jika belum punya sb_secret_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# SearchAPI.io API key (SERVER ONLY)
# Daftar: https://www.searchapi.io/
SEARCHAPI_KEY=your_searchapi_key

# Target rank
TARGET_QUERY=panen togel
TARGET_DOMAIN=panentogel.com

# Google SERP settings
SERP_DEVICE=mobile
SERP_COUNTRY=id
SERP_LANGUAGE=id
# Opsional. Contoh: Indonesia atau nama kota canonical dari SearchAPI Locations API.
SERP_LOCATION=Indonesia
# Google Rank Tracking API mendukung 1-100; 100 cocok untuk rank tracker.
SERP_NUM_RESULTS=100

# Proteksi endpoint /api/sync. Buat string acak minimal 16 karakter.
CRON_SECRET=ganti-dengan-random-string-panjang
